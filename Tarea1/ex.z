Z => Z chs := fn(Z n) -> sub(n)(0);

// Ejercicio 1 Teoremas de Morgan 
Z => Z => Z de_morgan1 := fn(Z p) -> fn(Z q) -> if(if(p, q, 0), 0, 1);
Z => Z => Z de_morgan2 := fn(Z p) -> fn(Z q) -> if(if(p, 1, q), 0, 1);

//Ejercicio 2 Sucesiones
Z => Z succ := fn(Z z) -> sub(chs(1))(z);

// Codigo para ejecutar directo en MiticalC (ZenSheet Zilly ICE)
Z => Z chs := fn(Z n) -> sub(n)(0);
Z => Z => Z de_morgan1 := fn(Z p) -> fn(Z q) -> if(if(p, q, 0), 0, 1);
Z => Z => Z de_morgan2 := fn(Z p) -> fn(Z q) -> if(if(p, 1, q), 0, 1);
Z => Z succ := fn(Z z) -> sub(chs(1))(z);

